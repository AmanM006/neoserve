# NeoServe tuned serving image for llama31-8b (w4a8)
# Winning config: w4a8 alloc=mimalloc bind=auto kv=16g mnbt=8192 fpmath=bf16  |  target: c8g.4xlarge
FROM --platform=linux/arm64 vllm/vllm-openai:latest
ENV LD_PRELOAD="/usr/local/lib/libmimalloc.so"
ENV ONEDNN_DEFAULT_FPMATH_MODE="BF16"
ENV VLLM_CPU_KVCACHE_SPACE="16"
ENV NEOSERVE_LSE_ATOMICS="off"
EXPOSE 8000
ENTRYPOINT ["/bin/bash","-lc"]
CMD ["vllm serve neoserve/llama31-8b-w4a8 --device cpu --dtype bfloat16 --max-model-len 8192 --max-num-batched-tokens 8192 --disable-log-requests --host 0.0.0.0 --port 8000"]
